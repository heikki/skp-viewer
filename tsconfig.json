{
  "extends": "@total-typescript/tsconfig/bundler",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "paths": {
      // Electrobun 2.x projects its SDK into .hutch/devkit (generated by
      // `electrobun sync`), not node_modules.
      "electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "@common/*": ["./src/client/common/*"],
      "@native/*": ["./resources/native/*"]
    }
  },
  "include": [
    "src",
    "resources/native/native-bridge.ts",
    "electrobun.config.ts",
    "hutch.config.ts",
    "eslint.config.js",
    "prettier.config.js"
  ],
  "exclude": ["node_modules"]
}
